-			TopoDS_Edge& E,
-			TopTools_DataMapOfShapeListOfShape& MVE )
-
-{ 
-  TopoDS_Vertex V1, V2;
-  TopTools_ListOfShape Empty;
-
-  TopExp::Vertices(E,V1,V2);
-  if (!MVE.IsBound(V1)) {
-    MVE.Bind(V1,Empty);
-  }
-  MVE(V1).Append(E);
-	
-  if (!MVE.IsBound(V2)) {
-    MVE.Bind(V2,Empty);
-  }
