-//=======================================================================
-//function : Perform
-//purpose  : 
-//=======================================================================
-void Partition_Loop::Perform()
-{
-
-  TopTools_DataMapOfShapeListOfShape MVE;
-  TopTools_DataMapIteratorOfDataMapOfShapeListOfShape Mapit, Mapit1;  
-  TopTools_ListIteratorOfListOfShape                  itl;
-  TopoDS_Vertex                                       V1,V2;
