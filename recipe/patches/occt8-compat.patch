-	    proj.LowerDistance() <= Precision::Confusion())
-	  return Standard_True;
-      }
-      else {
-        Handle(Geom_Curve) C1 = BRep_Tool::Curve( split ,f1,l1);
-	Handle(Geom_Curve) C2 = BRep_Tool::Curve( NewE  ,f2,l2);
