-      }
-    }
-    else {
-      Standard_Real u3 = BRep_Tool::Parameter( TopoDS::Vertex(V3), OldE);
-      Standard_Real u4 = BRep_Tool::Parameter( TopoDS::Vertex(V4), OldE);
