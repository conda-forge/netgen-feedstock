@@ -2535,9 +2535,9 @@ TopoDS_Shape
 
   m.def("BSplineCurve", [](std::vector<gp_Pnt> vpoles, int degree) {
       // not yet working ????
-      TColgp_Array1OfPnt poles(0, vpoles.size()-1);
-      TColStd_Array1OfReal knots(0, vpoles.size()+degree);
-      TColStd_Array1OfInteger mult(0, vpoles.size()+degree);
+      TColgp_Array1OfPnt poles(Standard_Integer(0), Standard_Integer(vpoles.size()-1));
+      TColStd_Array1OfReal knots(Standard_Integer(0), Standard_Integer(vpoles.size()+degree));
+      TColStd_Array1OfInteger mult(Standard_Integer(0), Standard_Integer(vpoles.size()+degree));
